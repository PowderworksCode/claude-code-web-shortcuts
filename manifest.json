{
  "manifest_version": 3,
  "name": "Claude Code Web Shortcuts",
  "version": "0.1.1",
  "description": "One-click (and keychord) canned replies next to the Claude Code web composer. Configurable; submits immediately.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["defaults.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Claude Code Web Shortcuts settings"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "claude-code-web-shortcuts@powderworks.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
